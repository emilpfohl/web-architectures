# Env-Datei für den One-Command-Start via Docker Compose.
# Kopieren nach .env, Werte eintragen, dann: docker compose up --build
# (siehe backend/.env.example für die Erklärung der einzelnen Variablen –
# hier nur die Docker-spezifische Zusammensetzung.)

# App-Port auf dem Host (Container lauscht intern immer auf 3000)
APP_PORT=3000

# MySQL-Zugangsdaten für den mysql-Service. DATABASE_URL wird daraus
# automatisch in docker-compose.yml zusammengesetzt (mysql://USER:PASSWORD@mysql:3306/DATABASE).
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=wg_planer
MYSQL_USER=wg_planer
MYSQL_PASSWORD=change-me

JWT_SECRET=change-me

# In Produktion: URL des deployten Frontends. Für den lokalen Docker-Start
# reicht http://localhost:3000, da Frontend und Backend im selben Container
# vom selben Origin ausgeliefert werden.
FRONTEND_URL=http://localhost:3000

# Resend (E-Mail-Versand): https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:example@example.com
