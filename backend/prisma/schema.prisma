// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id          Int          @id @default(autoincrement())
  name        String
  email       String       @unique
  memberships Membership[]
  todos       Todo[]
  finances    FinanceItem[]
  messages    Message[]
}

model WG {
  id          Int            @id @default(autoincrement())
  name        String
  createdAt   String
  memberships Membership[]
  shopping    ShoppingItem[]
  todos       Todo[]
  calendar    CalendarEvent[]
  finances    FinanceItem[]
  invitations Invitation[]
  messages    Message[]
}

model Membership {
  userId Int
  wgId   Int
  role   String
  user   User   @relation(fields: [userId], references: [id])
  wg     WG     @relation(fields: [wgId], references: [id])

  @@id([userId, wgId])
}

model ShoppingItem {
  id       Int     @id @default(autoincrement())
  wgId     Int
  name     String
  checked  Boolean @default(false)
  category String
  wg       WG      @relation(fields: [wgId], references: [id])
}

model Todo {
  id         Int     @id @default(autoincrement())
  wgId       Int
  title      String
  assigneeId Int?
  completed  Boolean @default(false)
  wg         WG      @relation(fields: [wgId], references: [id])
  assignee   User?   @relation(fields: [assigneeId], references: [id])
}

model CalendarEvent {
  id    Int    @id @default(autoincrement())
  wgId  Int
  date  String
  title String
  wg    WG     @relation(fields: [wgId], references: [id])
}

model FinanceItem {
  id          Int    @id @default(autoincrement())
  wgId        Int
  amount      Float
  description String
  paidById    Int
  wg          WG     @relation(fields: [wgId], references: [id])
  paidBy      User   @relation(fields: [paidById], references: [id])
}

model Invitation {
  id        Int    @id @default(autoincrement())
  wgId      Int
  token     String @unique
  role      String
  usedCount Int    @default(0)
  maxUses   Int
  wg        WG     @relation(fields: [wgId], references: [id])
}

model Message {
  id        Int      @id @default(autoincrement())
  wgId      Int
  type      String
  content   String
  senderId  Int?
  timestamp String
  wg        WG       @relation(fields: [wgId], references: [id])
  sender    User?    @relation(fields: [senderId], references: [id])
}
