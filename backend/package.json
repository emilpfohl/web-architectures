  "main": "server.js",
  "scripts": {
    "dev": "./node_modules/.bin/nodemon server.js",
    "db:test:setup": "TEST_DATABASE_URL=file:./test.db npx prisma generate --schema=prisma/schema.test.prisma && TEST_DATABASE_URL=file:./test.db npx prisma db push --schema=prisma/schema.test.prisma --skip-generate --accept-data-loss",
    "pretest": "npm run db:test:setup",
    "test": "vitest run",
    "test:watch": "npm run db:test:setup && vitest",
    "test:coverage": "npm run db:test:setup && vitest run --coverage"
  },
