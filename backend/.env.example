NODE_ENV=development

# MySQL/MariaDB Connection: mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL=mysql://user:password@host:3306/dbname

JWT_SECRET=change-me

# In Produktion: URL des deployten Frontends (z.B. https://mywg.de)
FRONTEND_URL=http://localhost:5173

# PORT wird auf Passenger-Hosting (cPanel/Plesk "Node.js App") automatisch
# als Env-Var gesetzt — hier nur für lokale/manuelle Starts relevant.

# Resend (E-Mail-Versand): https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:example@example.com
